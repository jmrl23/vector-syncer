# Copy to .env (0600, gitignored) and fill in the required values.
# Full reference: docs/design/08-configuration-and-deployment.md §2

# ── Azure / Microsoft Graph (required) ───────────────────────────
AZURE_TENANT_ID=                       # Entra tenant, or `consumers` for personal OneDrive
AZURE_CLIENT_ID=                       # Entra app registration's client ID
GRAPH_SCOPES=Files.Read offline_access User.Read   # add Files.Read.All if the folder is shared
ONEDRIVE_FOLDER_PATH=/Documents/KnowledgeBase       # folder to mirror

# ── Sync behavior ─────────────────────────────────────────────────
DELTA_SCOPE=folder                     # `root` = fallback mode (04-onedrive-graph-integration.md §4)
SYNC_CRON=*/5 * * * *                  # delta poll schedule

# ── Auth cache (required) ─────────────────────────────────────────
MSAL_CACHE_PATH=/app/data/msal-cache.bin
MSAL_CACHE_KEY=                        # 64 hex chars (32 bytes): openssl rand -hex 32

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Qdrant ─────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                        # set if Qdrant auth is enabled / cloud
QDRANT_COLLECTION_PREFIX=od_
ROOT_FILES_COLLECTION=_root            # empty = skip loose root files
CATALOG_COLLECTION=od_catalog

# ── Converter sidecar ──────────────────────────────────────────────
CONVERTER_URL=http://converter:8000

# ── AI provider — shared default (required) ───────────────────────
OPENAI_API_KEY=                        # DeepInfra token (or any OpenAI-compatible provider)
OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai

# ── AI provider — per-role overrides (optional) ────────────────────
# Leave blank to use the shared OPENAI_BASE_URL/OPENAI_API_KEY above for that role.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OCR_BASE_URL=
OCR_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

# ── Models (initial preferences — only EMBEDDING_MODEL costs a rebuild to change) ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TOKENIZER=Xenova/bge-m3       # must travel with EMBEDDING_MODEL (D15)
EMBEDDING_DIMENSIONS=1024               # must match model & every collection
EMBEDDING_BATCH_SIZE=64
OCR_LLM_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct   # empty = disable OCR
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash # catalog descriptions

# ── Hybrid search ───────────────────────────────────────────────────
SPARSE_MODE=bm25                        # `off` = dense-only fallback

# ── Chunking ─────────────────────────────────────────────────────────
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ── File handling ────────────────────────────────────────────────────
ALLOWED_EXTENSIONS=pdf,docx,pptx,xlsx,xls,csv,md,txt,html,htm,json,xml,epub,msg,png,jpg,jpeg
MAX_FILE_SIZE_MB=100
FILE_CONCURRENCY=4                      # runtime-adjustable via cli.js concurrency <n>
SCRATCH_DIR=/tmp/vector-syncer

# ── OCR fallback tier (optional) ─────────────────────────────────────
DOCINTEL_ENDPOINT=
DOCINTEL_KEY=

# ── Ops ────────────────────────────────────────────────────────────
BULL_BOARD_PORT=3001
LOG_LEVEL=info
